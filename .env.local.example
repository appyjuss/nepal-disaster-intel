# Copy to .env.local and `set -a; source .env.local; set +a` to run the lakehouse
# against MinIO instead of the local filesystem. Never commit real credentials.
MINIO_ROOT_USER=ndiplocal
MINIO_ROOT_PASSWORD=ndiplocal

NDIP_WAREHOUSE=s3://ndip-warehouse
NDIP_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=ndiplocal
AWS_SECRET_ACCESS_KEY=ndiplocal
AWS_REGION=us-east-1
